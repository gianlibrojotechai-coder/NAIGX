# NAIGX production environment — copy to `deploy/.env` and fill in.
#
#   cp deploy/.env.example deploy/.env
#
# ⚠️ `deploy/.env` IS GITIGNORED AND THIS FILE IS NOT. Never put a real
# secret in `.env.example`.
#
# Every variable below without a default is enforced: compose refuses to start
# without it, or `loadConfig` refuses to boot. That is deliberate — each one is
# a value whose absence would otherwise be papered over by a development
# default that is wrong in production.

# --- Edge -----------------------------------------------------------------

# The public hostname, and the `Host()` rule Traefik routes on (D-60).
#
# Its DNS A record must already point at this host BEFORE the first `up`: the
# shared Traefik requests a certificate as soon as the router appears, and a
# challenge that cannot be reached counts against the Let's Encrypt rate limit.
NAIGX_DOMAIN="naigx.example.com"

# ⚠️ NO `ACME_EMAIL` HERE ANY MORE. Since D-60 the host's existing Traefik
# terminates TLS and owns the ACME account; Caddy listens on a bare `:80`
# inside the network and requests no certificate. The ACME contact is part of
# that Traefik stack's configuration, not NAIGX's.

# --- Database -------------------------------------------------------------

POSTGRES_USER="naigx"

# Generate, do not invent:  openssl rand -base64 32
POSTGRES_PASSWORD=""

POSTGRES_DB="naigx"

# --- Application ----------------------------------------------------------

# Salt for the stored session and audit IP hash (`DB §4.1`, `DB §13`).
# The application REFUSES TO START under NODE_ENV=production without it: the
# development default is a constant in this repository, and an IP hash salted
# with a public constant enumerates back to the address in seconds, which makes
# the "Pseudonymous" classification false.
#
# Generate:  openssl rand -hex 32
#
# ⚠️ CHANGING THIS INVALIDATES EXISTING `ip_hash` COMPARISONS. Old rows do not
# become readable, they become uncomparable — abuse detection (`NFR-025`) loses
# its history. Rotate deliberately, not casually.
NAIGX_IP_HASH_SECRET=""

# The operator credential for `/internal/*` (D-48). Absent means the internal
# surface is DISABLED, which is a valid posture — Phase 4 needs it set so
# metrics can be scraped. `/internal/*` is blocked at the edge either way.
#
# Generate:  openssl rand -hex 32
NAIGX_OPERATOR_TOKEN=""

LOG_LEVEL="info"

# --- Not set here, deliberately -------------------------------------------
#
# NAIGX_EXECUTION_MODE — unset resolves to replay, which bills nothing. The
#   standing no-provider-spend constraint means this file is not where a
#   metered mode gets switched on.
#
# ANTHROPIC_API_KEY / PROVIDER_MODEL / PROVIDER_*_USD_PER_MTOK — only needed
#   for a metered instance. See `backend/.env.example`.
#
# HOST — stays at its `0.0.0.0` default. Inside a container that means "every
#   interface of this container", which is what Caddy needs; the app is kept
#   off the internet by publishing no port for it, not by the bind address.

# --- Application-level encryption key (D-61, DB 13.1 row 3) -----------------
#
# PATH to a file holding the root key. NOT key material, and never commit the
# file it points at.
#
# The application REFUSES TO START under NODE_ENV=production without this.
# There is deliberately no in-process fallback: an instance that generated its
# own key would seal content nothing else could ever open, and would look
# entirely healthy doing it.
#
# Create it on the host, OUTSIDE this repository and outside the Docker build
# context, owned by the account the container runs as (uid 1000) and readable
# by nobody else. The provider refuses to load a file with any group or other
# permission bit set.
#
#   sudo install -d -m 0755 -o root -g root /etc/naigx/keys
#   sudo sh -c 'openssl rand -base64 32 > /etc/naigx/keys/root.key'
#   sudo chown 1000:1000 /etc/naigx/keys/root.key
#   sudo chmod 0400 /etc/naigx/keys/root.key
#
# WARNING: LOSING THIS FILE DESTROYS raw_content, structured_input AND
# structured_output - in the database AND in every backup. Back it up
# SEPARATELY from the database dumps: a single backup containing both the
# ciphertext and the key protects neither.
#
# WARNING: this is a host-held key, not a managed key service. There is no
# central revocation and no decrypt audit trail, and a full host compromise
# reaches it. DB 13.1's managed-key-service row is an explicit v1.0 deviation,
# recorded in D-61 section 4 rather than claimed as satisfied.
NAIGX_KEY_FILE="/etc/naigx/keys/root.key"

# --- Monitoring and alerting (NFR-082, NFR-085) -----------------------------
#
# Prometheus scrapes /internal/metrics over the compose network using
# NAIGX_OPERATOR_TOKEN above — so that token becomes REQUIRED once monitoring
# runs. ⚠️ A wrong token makes every scrape 401 and the target read as "down",
# which is indistinguishable from the application being dead.
#
# Where a firing alert is delivered. ⚠️ REQUIRED: an alert that fires into
# nothing is not alerting, and Alertmanager starts happily with an unreachable
# receiver — it logs the delivery failure and nobody is paged. Send a test
# alert after deploying (deploy/README.md).
#
# Any endpoint that reaches a person: a chat incoming-webhook, an email bridge,
# a phone-notification service.
NAIGX_ALERT_WEBHOOK=""

# --- Backups (D-51 §4) ------------------------------------------------------
#
# ⚠️ THIS MUST BE STORAGE THAT LEAVES THE HOST. D-51 §4 requires backups stored
# off the deployment host — host loss must not take the backups with it. A
# local path satisfies the schedule and NOT the requirement. Use a mounted
# object store, a network share, or a remote filesystem.
#
# ⚠️ The dumps contain CIPHERTEXT for raw_content, structured_input and
# structured_output, so restoring them depends on `NAIGX_KEY_FILE` still
# existing. Losing the root key destroys these backups as surely as deleting
# them — and ⚠️ **do not store the key alongside the dumps**, because a single
# archive holding both the ciphertext and its key protects neither (D-61 §4).
NAIGX_BACKUP_DIR="/mnt/naigx-backups"

# DBQ-7, resolved at 7 days (D-51). Published in the data policy page — the
# deletion promise is false if the backup window is not disclosed.
BACKUP_RETENTION_DAYS="7"

# --- The live switch (D-67) — read ONLY by docker-compose.live.yml -----------
#
# None of these do anything unless the overlay is named on the command line:
#   docker compose -f docker-compose.prod.yml -f docker-compose.live.yml ...
# See deploy/README.md "The owner-only live switch".
#
# Host PATH to a file containing only the provider API key (chmod 600, owned
# by root, OUTSIDE /opt/naigx). Never the key itself. Create it with:
#   umask 077 && printf '%s' 'sk-ant-...' > /etc/naigx/provider.key
NAIGX_PROVIDER_KEY_FILE=""
# The owner account email(s), comma-separated. Registration and sign-in are
# refused for any other address; sessions of other accounts resolve to nothing.
NAIGX_ACCESS_ALLOWLIST=""
# "disabled" for an owner-only instance. Must be set explicitly on a live one.
NAIGX_ANONYMOUS_ANALYSIS="disabled"
# Decimal USD, UTC calendar windows, checked before every analysis with a
# per-analysis reserve (default 0.30) charged up front.
NAIGX_SPEND_CAP_USD_PER_DAY=""
NAIGX_SPEND_CAP_USD_PER_MONTH=""
# NAIGX_SPEND_RESERVE_USD_PER_ANALYSIS="0.30"
# Model and rates. Re-verify the rates on the pricing page before changing.
# NAIGX_PROVIDER_MODEL="claude-sonnet-5"
NAIGX_PROVIDER_INPUT_USD_PER_MTOK="2.00"
NAIGX_PROVIDER_OUTPUT_USD_PER_MTOK="10.00"
# NAIGX_PROVIDER_EFFORT="medium"
