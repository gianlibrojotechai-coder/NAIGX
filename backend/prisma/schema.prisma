// NAIGX primary store — `DB §4` primary domains.
//
// Scope: Identity (§4.1), Analysis (§4.2), Reasoning (§4.3), Configuration (§4.5).
// ArtifactSchema is included because `DB §3.1` places it in the Configuration domain.
//
// Deliberately NOT here:
//   · Trace Store (§4.7)      — separate PostgreSQL database (`docs/12` D-2).
//                               No foreign key crosses the store boundary (§1.4).
//   · Artifact domain (§4.4)  — Artifact, ArtifactPlanEntry, Export.
//   · Operational (§4.6)      — Feedback, AuditEvent.
//   · ApiKey / Role (§10.1)   — no entity specification exists; §10.4 says role and
//                               permission tables are deliberately not built.
//
// Physical names follow the snake_case names used by `DB §4`. Nullability follows
// the specification, except where §6.2 progressive persistence requires a column to
// be absent at `queued` time — those are marked below.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Sprint 0 liveness probe. Unrelated to the domain model; left exactly as it was.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Enumerations
//
// Only closed sets that an authoritative document actually enumerates appear
// here. Vocabularies the documents leave undefined are typed `String` rather
// than guessed — see the report accompanying this schema.
// ---------------------------------------------------------------------------

/// `DB §4.2` ANALYSIS.
enum AnalysisStatus {
  queued
  running
  completed
  failed
  timed_out

  @@map("analysis_status")
}

/// `DB §4.2` ANALYSIS_INPUT.
enum SourceType {
  paste
  file

  @@map("source_type")
}

/// `FR-011`. Five values, not the six of `AI §4.1`: `docs/12` D-6 establishes
/// `mixed` as an internal Stage 1 detection state that resolves to a dominant
/// type before the stage completes, never a terminal persisted value.
/// The `AI §4.1` / `FR-011` divergence is recorded as `AIQ-9`, unresolved.
enum ClassificationType {
  business_requirement
  existing_workflow
  job_description
  technical_assessment
  unsupported

  @@map("classification_type")
}

/// `DB §4.2` CONTEXT_ELEMENT.
enum ContextProvenance {
  stated
  inferred
  unknown

  @@map("context_provenance")
}

/// `AI §8.4` — bands, not scores.
enum ConfidenceBand {
  high
  medium
  low

  @@map("confidence_band")
}

/// `AI §5.4`.
enum SufficiencyLevel {
  sufficient
  thin
  insufficient

  @@map("sufficiency_level")
}

/// `DB §4.5` PROMPT_FRAGMENT.
enum FragmentClass {
  foundation
  stage
  type_modifier
  artifact
  output_contract

  @@map("fragment_class")
}

/// `DB §4.3` CONTEXT_REFERENCE — "a closed set with the discriminator required".
/// The two members are the two targets its Relationships row names.
enum ReferencingType {
  recommendation
  architecture_component

  @@map("referencing_type")
}

/// `DB §4.4` EXPORT.format. Referenced here only by UserSettings.
enum ExportFormat {
  markdown
  pdf

  @@map("export_format")
}

// ---------------------------------------------------------------------------
// §4.1 Identity Domain
// ---------------------------------------------------------------------------

/// Identity and ownership anchor for all user data.
model User {
  userId          String    @id @default(uuid()) @map("user_id") @db.Uuid
  /// Classified PII (§13.2) — encrypted at rest, never logged.
  email           String    @unique
  /// Classified Credential (§13.2) — hashed, irreversible, never exported.
  /// Nullable so that "never null for active accounts" is expressible; a CHECK
  /// constraint in the migration ties nullability to `deleted_at`.
  credentialHash  String?   @map("credential_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  deletedAt       DateTime? @map("deleted_at")
  /// `NFR-030` — defaults false; requires an explicit affirmative act to set.
  trainingConsent Boolean   @default(false) @map("training_consent")

  sessions Session[]
  settings UserSettings?
  analyses Analysis[]

  @@index([deletedAt])
  @@map("user")
}

/// Authenticated session state.
model Session {
  sessionId      String    @id @default(uuid()) @map("session_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Classified Credential (§13.2) — stored hashed, never raw.
  tokenHash      String    @map("token_hash")
  issuedAt       DateTime  @default(now()) @map("issued_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  /// Pseudonymous (§13.2). Raw IP is never persisted (`NFR-025`).
  userAgentClass String    @map("user_agent_class")
  ipHash         String    @map("ip_hash")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// User preferences. Deliberately minimal (`FR-071`); growth here is drift.
model UserSettings {
  userId              String       @id @map("user_id") @db.Uuid
  /// §4.1 requires every setting to carry a non-null default, but no document
  /// names which format that default is. Left without a database default
  /// rather than inventing one — see the accompanying report.
  defaultExportFormat ExportFormat @map("default_export_format")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_settings")
}

// ---------------------------------------------------------------------------
// §4.2 Analysis Domain
// ---------------------------------------------------------------------------

/// The root record of one reasoning run. The unit of ownership, retrieval,
/// deletion, and export. Immutable once `status` is terminal (DP-3) — enforced
/// by the application, not by the schema.
model Analysis {
  analysisId            String            @id @default(uuid()) @map("analysis_id") @db.Uuid
  /// Nullable for anonymous analyses (`FR-004`).
  userId                String?           @map("user_id") @db.Uuid
  anonymousTokenHash    String?           @map("anonymous_token_hash")
  status                AnalysisStatus
  createdAt             DateTime          @default(now()) @map("created_at")
  completedAt           DateTime?         @map("completed_at")
  /// Written once a title can be derived; absent at `queued` (§6.2).
  derivedTitle          String?           @map("derived_title")
  /// Absent at `queued` — no model has been invoked yet (§6.1, §6.2).
  modelVersionId        String?           @map("model_version_id") @db.Uuid
  /// Written at Stage 11 (§6.1).
  overallConfidenceBand ConfidenceBand?   @map("overall_confidence_band")
  /// Written at Stage 3 (`AI §5.4`).
  sufficiencyLevel      SufficiencyLevel? @map("sufficiency_level")
  degradationFlag       Boolean           @default(false) @map("degradation_flag")
  timeoutFlag           Boolean           @default(false) @map("timeout_flag")
  /// `FR-064` re-analysis lineage; the original is preserved (DP-3).
  supersedesAnalysisId  String?           @map("supersedes_analysis_id") @db.Uuid

  user         User?         @relation(fields: [userId], references: [userId], onDelete: Cascade)
  /// §5.3 — RESTRICT. A model version referenced by history is never deletable;
  /// it is deactivated instead (DP-7). Prisma would default an optional relation
  /// to SET NULL, which would silently erase drift attribution (`AI-004`).
  modelVersion ModelVersion? @relation(fields: [modelVersionId], references: [modelVersionId], onDelete: Restrict)
  supersedes   Analysis?     @relation("AnalysisSupersedes", fields: [supersedesAnalysisId], references: [analysisId])
  supersededBy Analysis[]    @relation("AnalysisSupersedes")

  input                AnalysisInput?
  classification       Classification?
  intentRecord         IntentRecord?
  contextElements      ContextElement[]
  architectureModel    ArchitectureModel?
  recommendations      Recommendation[]
  requiredCapabilities RequiredCapability[]
  artifactPlanEntries  ArtifactPlanEntry[]
  artifacts            Artifact[]
  riskItems            RiskItem[]
  complexityAssessment ComplexityAssessment?
  fragmentUsages       FragmentUsage[]

  /// `FR-061` history listing.
  @@index([userId, createdAt(sort: Desc)])
  /// Job recovery.
  @@index([status])
  @@index([anonymousTokenHash])
  @@map("analysis")
}

/// The exact submitted content, preserved verbatim. Separated 1:1 from Analysis
/// because `raw_content` is the most sensitive field in the schema — separation
/// keeps the hot path narrow and makes encryption targetable (§4.2, `docs/12` D-5).
model AnalysisInput {
  analysisId       String     @id @map("analysis_id") @db.Uuid
  /// Classified Confidential business (§13.2) — application-level encryption,
  /// never logged, never in telemetry. `DBQ-8` governs the mechanism.
  rawContent       String     @map("raw_content")
  contentHash      String     @map("content_hash")
  /// `FR-002` bounds: 50–50,000. Enforced by CHECK in the migration.
  characterCount   Int        @map("character_count")
  sourceType       SourceType @map("source_type")
  originalFilename String?    @map("original_filename")

  analysis Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)

  /// Duplicate detection and regression-corpus matching.
  @@index([contentHash])
  @@map("analysis_input")
}

/// Stage 1 output, including override history. The system's determination and
/// the user's override are stored separately — overwriting would destroy `M-6`.
model Classification {
  analysisId       String               @id @map("analysis_id") @db.Uuid
  determinedType   ClassificationType   @map("determined_type")
  /// `FR-011` — in [0,1]. Enforced by CHECK in the migration.
  confidence       Float
  /// Ordered set. Carries the secondary type when Stage 1 detected a mixed
  /// input (`docs/12` D-6); `AI §4.3` discloses the secondary, `API §4.2`
  /// defers a first-class `secondary_classification` field to a later version.
  candidateTypes   ClassificationType[] @map("candidate_types")
  wasLowConfidence Boolean              @map("was_low_confidence")
  userOverrideType ClassificationType?  @map("user_override_type")
  overriddenAt     DateTime?            @map("overridden_at")

  analysis Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)

  @@index([determinedType])
  @@index([userOverrideType])
  @@map("classification")
}

/// Stage 2 output.
model IntentRecord {
  intentId            String @id @default(uuid()) @map("intent_id") @db.Uuid
  analysisId          String @unique @map("analysis_id") @db.Uuid
  primaryObjective    String @map("primary_objective")
  /// Multi-valued; §4.2 specifies no child entity, so both this and the
  /// per-element provenance required by its Constraints row are documents.
  secondaryObjectives Json   @map("secondary_objectives")
  inferredScope       String @map("inferred_scope")
  /// Every objective element carries provenance ∈ {stated, inferred} (§4.2).
  objectiveProvenance Json   @map("objective_provenance")

  analysis Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)

  @@map("intent_record")
}

/// Stage 3 output. The grounding layer for the entire traceability chain.
model ContextElement {
  contextElementId String            @id @default(uuid()) @map("context_element_id") @db.Uuid
  analysisId       String            @map("analysis_id") @db.Uuid
  content          String
  /// Vocabulary undefined by every authoritative document — typed as text.
  category         String
  provenance       ContextProvenance
  sourceSpanStart  Int?              @map("source_span_start")
  sourceSpanEnd    Int?              @map("source_span_end")
  inferenceBasis   String?           @map("inference_basis")
  resolutionHint   String?           @map("resolution_hint")
  /// Feeds confidence factor CF-4 (`AI §8.2`). Scale undefined.
  specificityScore Float             @map("specificity_score")
  /// Feeds CF-3.
  conflictsWithId  String?           @map("conflicts_with_id") @db.Uuid

  analysis      Analysis           @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  conflictsWith ContextElement?    @relation("ContextElementConflict", fields: [conflictsWithId], references: [contextElementId])
  conflictedBy  ContextElement[]   @relation("ContextElementConflict")
  references    ContextReference[]

  @@index([analysisId, provenance])
  @@index([conflictsWithId])
  @@map("context_element")
}

// ---------------------------------------------------------------------------
// §4.3 Reasoning Domain
// ---------------------------------------------------------------------------

/// Stage 6 output — the design root. Present only for architecture-producing
/// paths (`AI §4.1`), hence 1:0..1 from Analysis.
model ArchitectureModel {
  architectureId      String   @id @default(uuid()) @map("architecture_id") @db.Uuid
  analysisId          String   @unique @map("analysis_id") @db.Uuid
  summary             String
  dataFlowDescription String   @map("data_flow_description")
  createdAt           DateTime @default(now()) @map("created_at")

  analysis   Analysis                @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  components ArchitectureComponent[]

  @@map("architecture_model")
}

/// An individual component with its justification. `FR-030` requires at least
/// one context reference per component; because references are polymorphic,
/// that is a validation-time rule (Stage 10), not a schema constraint.
model ArchitectureComponent {
  componentId          String  @id @default(uuid()) @map("component_id") @db.Uuid
  architectureId       String  @map("architecture_id") @db.Uuid
  name                 String
  responsibility       String
  inputs               String
  outputs              String
  failureHandling      String  @map("failure_handling")
  integrationDirection String? @map("integration_direction")
  externalSystem       String? @map("external_system")
  ordinal              Int

  architecture ArchitectureModel @relation(fields: [architectureId], references: [architectureId], onDelete: Cascade)
  riskItems    RiskItem[]

  @@unique([architectureId, name])
  @@index([architectureId])
  @@map("architecture_component")
}

/// Stage 7 output. `rationale` and `criteria_applied` are non-nullable and
/// non-empty so that an unexplained recommendation cannot be represented
/// (`AIP-4`) — the database is the enforcement point.
model Recommendation {
  recommendationId     String         @id @default(uuid()) @map("recommendation_id") @db.Uuid
  analysisId           String         @map("analysis_id") @db.Uuid
  /// Vocabulary undefined by every authoritative document — typed as text.
  recommendationType   String         @map("recommendation_type")
  conclusion           String
  rationale            String
  /// `AIP-4`/`DD-04` — non-nullable so an unexplained recommendation cannot be
  /// represented. Briefly relaxed while Stage 7 produced no criteria; restored
  /// once it did (`AI §3.2`).
  criteriaApplied      String         @map("criteria_applied")
  limits               String?
  confidenceBand       ConfidenceBand? @map("confidence_band")
  /// Below `high` requires non-empty factors (`FR-018`, `FR-045`).
  confidenceFactors    Json?          @map("confidence_factors")
  /// Stored explicitly so `AC-013` is verifiable by query.
  isNegativeConclusion Boolean        @map("is_negative_conclusion")

  analysis               Analysis                    @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  alternatives           RecommendationAlternative[]
  platformRecommendation PlatformRecommendation?

  @@index([analysisId])
  @@index([isNegativeConclusion])
  @@map("recommendation")
}

/// What was considered and rejected (`AI-031`). Modelled as a relation so that
/// `FR-034` — at least one named rejected alternative — is countable.
model RecommendationAlternative {
  alternativeId    String @id @default(uuid()) @map("alternative_id") @db.Uuid
  recommendationId String @map("recommendation_id") @db.Uuid
  alternative      String
  rejectionReason  String @map("rejection_reason")
  ordinal          Int

  recommendation Recommendation @relation(fields: [recommendationId], references: [recommendationId], onDelete: Cascade)

  @@index([recommendationId])
  @@map("recommendation_alternative")
}

/// The traceability join. Polymorphic to Recommendation or ArchitectureComponent
/// via `referencing_type`; only the ContextElement side is a foreign key, so the
/// §5.3 cascade from Recommendation is an application-side responsibility.
model ContextReference {
  referenceId      String          @id @default(uuid()) @map("reference_id") @db.Uuid
  contextElementId String          @map("context_element_id") @db.Uuid
  referencingType  ReferencingType @map("referencing_type")
  referencingId    String          @map("referencing_id") @db.Uuid
  /// Vocabulary undefined by every authoritative document — typed as text.
  relevance        String

  contextElement ContextElement @relation(fields: [contextElementId], references: [contextElementId], onDelete: Cascade)

  @@index([contextElementId])
  @@index([referencingType, referencingId])
  @@map("context_reference")
}

/// Platform-selection specialization. Neutrality is enforced by absence: there
/// is no column for a commercial relationship, ranking weight, or partner
/// status, and none may be added (`PV §3.3`).
model PlatformRecommendation {
  platformRecommendationId String  @id @default(uuid()) @map("platform_recommendation_id") @db.Uuid
  recommendationId         String  @unique @map("recommendation_id") @db.Uuid
  /// Null means no platform / do not automate — valid and meaningful (`FR-034`).
  recommendedPlatform      String? @map("recommended_platform")
  selectionCriteria        String  @map("selection_criteria")
  knowledgeCurrencyNote    String  @map("knowledge_currency_note")

  recommendation Recommendation @relation(fields: [recommendationId], references: [recommendationId], onDelete: Cascade)

  /// Neutrality auditing (`AC-032`).
  @@index([recommendedPlatform])
  @@map("platform_recommendation")
}

/// Risk register entries (`FR-032`). Non-nullable `component_id` is the schema
/// enforcement of "no generic risks" — a risk that cannot name what it affects
/// cannot be stored. Severity and likelihood are the 1–5 integer scales of
/// `docs/09-Scoring-Scales.md` §2; score and band are derived, never stored.
model RiskItem {
  riskId      String @id @default(uuid()) @map("risk_id") @db.Uuid
  analysisId  String @map("analysis_id") @db.Uuid
  componentId String @map("component_id") @db.Uuid
  description String
  severity    Int
  likelihood  Int
  mitigation  String

  analysis  Analysis              @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  component ArchitectureComponent @relation(fields: [componentId], references: [componentId], onDelete: Cascade)

  @@index([analysisId])
  @@index([severity, likelihood])
  @@map("risk_item")
}

/// Complexity score with reconstructible basis (`FR-033`). Storing the factor
/// breakdown — not just the score — is what makes the score reconstructible
/// from storage. `scale_version` prevents silent comparison across scale
/// revisions; v1 is `complexity-v1` (`docs/09` §1).
model ComplexityAssessment {
  assessmentId    String @id @default(uuid()) @map("assessment_id") @db.Uuid
  analysisId      String @unique @map("analysis_id") @db.Uuid
  score           Int
  /// Rows of (factor, value, weight, contribution). Σ contributions × 20 = score.
  factorBreakdown Json   @map("factor_breakdown")
  scaleVersion    String @map("scale_version")

  analysis Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)

  @@map("complexity_assessment")
}

// ---------------------------------------------------------------------------
// §4.5 Configuration Domain
// ---------------------------------------------------------------------------

/// Identity of a composable prompt fragment (`AI §6.2`). Created once, never
/// deleted.
model PromptFragment {
  fragmentId    String        @id @default(uuid()) @map("fragment_id") @db.Uuid
  fragmentKey   String        @unique @map("fragment_key")
  fragmentClass FragmentClass @map("fragment_class")
  /// Vocabulary undefined by every authoritative document — typed as text.
  ownerClass    String        @map("owner_class")
  createdAt     DateTime      @default(now()) @map("created_at")

  versions PromptFragmentVersion[]

  @@map("prompt_fragment")
}

/// An immutable version of a fragment. Append-only, never updated (DP-4).
///
/// `docs/12` D-3: fragments are authored in `prompts/` under Git review and
/// published here; the runtime resolves `content` from this table, which is what
/// makes rollback without a code deploy possible (`AI-014`). `content_hash`
/// detects divergence between the reviewed source and the published row.
model PromptFragmentVersion {
  fragmentVersionId       String    @id @default(uuid()) @map("fragment_version_id") @db.Uuid
  fragmentId              String    @map("fragment_id") @db.Uuid
  version                 String
  /// The published fragment text — the attribute §4.5 left open pending `DBQ-5`.
  content                 String
  contentHash             String    @map("content_hash")
  createdAt               DateTime  @default(now()) @map("created_at")
  activatedAt             DateTime? @map("activated_at")
  deprecatedAt            DateTime? @map("deprecated_at")
  /// `NFR-043` is a data constraint, not process discipline: activation without
  /// a recorded passing regression run is rejected by CHECK in the migration.
  regressionPassReference String?   @map("regression_pass_reference")

  fragment PromptFragment  @relation(fields: [fragmentId], references: [fragmentId])
  usages   FragmentUsage[]

  @@unique([fragmentId, version])
  @@index([activatedAt])
  @@map("prompt_fragment_version")
}

/// The exact fragment composition used by one analysis (`AI-013`). Records the
/// resolved composition, not current configuration (DP-5) — this is the join
/// that makes quality attribution possible.
model FragmentUsage {
  usageId           String @id @default(uuid()) @map("usage_id") @db.Uuid
  analysisId        String @map("analysis_id") @db.Uuid
  fragmentVersionId String @map("fragment_version_id") @db.Uuid
  /// Stage key. The stage vocabulary is unsettled while `AIQ-10` is open.
  stage             String
  ordinal           Int

  analysis        Analysis              @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  fragmentVersion PromptFragmentVersion @relation(fields: [fragmentVersionId], references: [fragmentVersionId], onDelete: Restrict)

  @@index([analysisId])
  /// Impact analysis: which analyses used a suspect fragment version.
  @@index([fragmentVersionId])
  @@map("fragment_usage")
}

/// Reference data for model providers. Providers are rows, not schema (DP-6) —
/// adding a provider is a data operation (`docs/12` D-4). `declared_capabilities`
/// backs the `AI §10.2` capability-detection model: the abstraction layer reads
/// declarations rather than assuming. Never exposed in output or export (`AI-006`).
model Provider {
  providerId           String   @id @default(uuid()) @map("provider_id") @db.Uuid
  providerKey          String   @unique @map("provider_key")
  declaredCapabilities Json     @map("declared_capabilities")
  active               Boolean
  createdAt            DateTime @default(now()) @map("created_at")

  modelVersions ModelVersion[]

  @@map("provider")
}

/// A specific model version, for drift attribution (`AI-004`). Its existence is
/// what makes `SA AR-41` — silent model drift — detectable. Append-only (DP-4);
/// deactivated, never deleted (DP-7).
model ModelVersion {
  modelVersionId String   @id @default(uuid()) @map("model_version_id") @db.Uuid
  providerId     String   @map("provider_id") @db.Uuid
  modelKey       String   @map("model_key")
  versionLabel   String   @map("version_label")
  firstSeenAt    DateTime @default(now()) @map("first_seen_at")
  active         Boolean

  provider Provider   @relation(fields: [providerId], references: [providerId], onDelete: Restrict)
  analyses Analysis[]

  @@unique([providerId, modelKey, versionLabel])
  @@map("model_version")
}

/// Versioned artifact schema definitions. Append-only (DP-4); never hard-deleted
/// while referenced.
///
/// `docs/12` D-1: `definition` holds a JSON Schema draft 2020-12 document. The
/// same document is injected into the Output Contract prompt fragment (`AI §6.1`)
/// and drives deterministic validation (`FR-039`) — `AI §9.3` requires that
/// generation guidance and validation cannot disagree, which is only possible
/// when both read one stored document. Typed `Json`, not text, for that reason.
///
/// The Artifact side of its 1:N relationship lives in the excluded Artifact
/// domain and arrives with that domain.
model ArtifactSchema {
  schemaId      String    @id @default(uuid()) @map("schema_id") @db.Uuid
  artifactType  String    @map("artifact_type")
  version       String
  definition    Json
  effectiveFrom DateTime  @map("effective_from")
  deprecatedAt  DateTime? @map("deprecated_at")

  artifacts Artifact[]

  @@unique([artifactType, version])
  @@map("artifact_schema")
}

// --- Stage 7 output, job-description path (`FR-022`) ----------------------

/// `FR-012` — every intent element is labelled stated or inferred. Narrower
/// than ContextProvenance, which also admits `unknown`: a requirement the
/// posting does not state is not extracted at all.
enum IntentProvenance {
  stated
  inferred

  @@map("intent_provenance")
}

/// `AI §4.3` necessity. Mirrors `REQUIREMENT_NECESSITY`.
enum RequirementNecessity {
  must_have
  nice_to_have

  @@map("requirement_necessity")
}

/// `docs/12` D-28 — what closing a requirement would take, and so whether a
/// build could. Only `technical` is buildable.
enum RequirementKind {
  technical
  domain_experience
  track_record
  disposition

  @@map("requirement_kind")
}

enum MatchStrength {
  strong
  partial

  @@map("match_strength")
}

enum GapPriority {
  high
  medium
  low

  @@map("gap_priority")
}

/// One capability a posting requires (`FR-022`).
///
/// `external_id` is Stage 7's own identifier (`req-1`), kept because the
/// verdict's decisive gaps and a project's primary gaps both cite it. Without
/// it those references would have to be rewritten to UUIDs at persistence and
/// rewritten back on read.
model RequiredCapability {
  requiredCapabilityId String               @id @default(uuid()) @map("required_capability_id") @db.Uuid
  analysisId           String               @map("analysis_id") @db.Uuid
  externalId           String               @map("external_id")
  name                 String
  necessity            RequirementNecessity
  /// `stated` or `inferred` (`FR-012`).
  provenance           IntentProvenance
  kind                 RequirementKind
  ordinal              Int

  analysis Analysis          @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  matches  CapabilityMatch[]
  gaps     CapabilityGap[]

  @@unique([analysisId, externalId])
  @@index([analysisId])
  @@map("required_capability")
}

/// A requirement the operator already evidences (`docs/12` D-27).
model CapabilityMatch {
  matchId              String        @id @default(uuid()) @map("match_id") @db.Uuid
  requiredCapabilityId String        @map("required_capability_id") @db.Uuid
  /// Resolves in the authored capability profile, never written by the system.
  capabilityId         String        @map("capability_id")
  strength             MatchStrength
  /// The specific evidence locator a reader could open.
  evidenceRef          String        @map("evidence_ref")

  requiredCapability RequiredCapability @relation(fields: [requiredCapabilityId], references: [requiredCapabilityId], onDelete: Cascade)

  @@index([requiredCapabilityId])
  @@map("capability_match")
}

/// A requirement nothing in the profile evidences.
///
/// `decisive` carries `verdict.decisive_gaps` rather than a second list: a gap
/// is decisive or it is not, and storing the verdict's copy separately would
/// let the two disagree.
model CapabilityGap {
  gapId                String      @id @default(uuid()) @map("gap_id") @db.Uuid
  requiredCapabilityId String      @map("required_capability_id") @db.Uuid
  priority             GapPriority
  whyItMatters         String      @map("why_it_matters")
  decisive             Boolean     @default(false)

  requiredCapability RequiredCapability @relation(fields: [requiredCapabilityId], references: [requiredCapabilityId], onDelete: Cascade)

  @@index([requiredCapabilityId])
  @@map("capability_gap")
}

// --- `DB §4.4` Artifact Domain -------------------------------------------

/// `DB §4.4` ARTIFACT_PLAN_ENTRY.outcome.
enum ArtifactOutcome {
  generated
  failed
  omitted

  @@map("artifact_outcome")
}

/// `DB §4.4` ARTIFACT.validation_status. Only `valid` is presentable.
enum ValidationStatus {
  valid
  failed

  @@map("validation_status")
}

/// `DB §4.4` ARTIFACT_PLAN_ENTRY — Stage 8 output.
///
/// Exists so omission and failure are distinguishable in storage (`FR-091`,
/// `AIP-8`): a missing artifact is otherwise ambiguous, and "chose not to" and
/// "tried and failed" mean opposite things about an analysis.
model ArtifactPlanEntry {
  planEntryId     String           @id @default(uuid()) @map("plan_entry_id") @db.Uuid
  analysisId      String           @map("analysis_id") @db.Uuid
  artifactType    String           @map("artifact_type")
  planned         Boolean
  /// v1 domain is the single value `standard` (`docs/12` D-34).
  depthLevel      String           @map("depth_level")
  inclusionReason String?          @map("inclusion_reason")
  omissionReason  String?          @map("omission_reason")
  /// Nullable between Stage 8 and Stage 9: `DB §4.4` writes the row at Stage 8
  /// and sets the outcome at Stage 9-10, so a planned entry legitimately has
  /// none yet. The nullability question `docs/12` D-34 recorded is left open.
  outcome         ArtifactOutcome?

  analysis Analysis  @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  artifact Artifact?

  @@index([analysisId])
  @@index([artifactType, outcome])
  @@map("artifact_plan_entry")
}

/// `DB §4.4` ARTIFACT — a generated output artifact.
///
/// Content is a structured document (`DP-1`): retrieved whole, never queried by
/// internal structure. `schema_id` is a reference, not a copy, so an artifact
/// always knows which schema version it satisfied.
///
/// **Failed artifacts are stored, not discarded** — that is what lets a user
/// see a labelled failure rather than an unexplained gap.
model Artifact {
  artifactId             String           @id @default(uuid()) @map("artifact_id") @db.Uuid
  analysisId             String           @map("analysis_id") @db.Uuid
  planEntryId            String           @unique @map("plan_entry_id") @db.Uuid
  artifactType           String           @map("artifact_type")
  schemaId               String           @map("schema_id") @db.Uuid
  content                Json
  depthLevel             String           @map("depth_level")
  /// Regeneration count; feeds confidence factor CF-6 when Stage 11 exists.
  generationAttemptCount Int              @default(1) @map("generation_attempt_count")
  validationStatus       ValidationStatus @map("validation_status")
  createdAt              DateTime         @default(now()) @map("created_at")

  analysis  Analysis          @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  planEntry ArtifactPlanEntry @relation(fields: [planEntryId], references: [planEntryId], onDelete: Cascade)
  /// §5.3 RESTRICT — a schema referenced by a stored artifact is never
  /// deletable; it is deprecated instead (DP-7).
  schema    ArtifactSchema    @relation(fields: [schemaId], references: [schemaId], onDelete: Restrict)

  @@index([analysisId, artifactType])
  @@index([validationStatus])
  @@map("artifact")
}
