# Primary store — Identity, Analysis, Reasoning, Configuration domains (DB §4).
DATABASE_URL="postgresql://naigx:naigx_dev_password@localhost:5432/naigx"

# Trace store — StageTrace, ProviderInvocation, ValidationEvent (DB §4.7, §8).
# A SEPARATE database (DB §1.4, docs/12 D-2), never the same as DATABASE_URL.
# Kept distinct so the two stores can be given distinct credentials: §8.4
# restricts trace reads to operators.
TRACE_DATABASE_URL="postgresql://naigx:naigx_dev_password@localhost:5432/naigx_trace"

PORT=3000
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL=info

# The interface to bind. Default is 0.0.0.0 (every interface), which is what a
# container needs — inside one it means "every interface of THIS container",
# and the production compose keeps the app private by publishing no port for
# it, not by the bind address. Set 127.0.0.1 only for a bare process sharing a
# host with its proxy.
# HOST=0.0.0.0

# Whether X-Forwarded-* may be believed. Leave false unless a trusted reverse
# proxy is in front: it decides what `request.ip` means, and `request.ip` is
# the per-IP auth rate-limit bucket and the session IP hash. False behind a
# proxy makes one shared bucket for everybody; true without one lets any client
# forge its own. `docker-compose.prod.yml` sets it true because it creates the
# proxy. Accepts true/false/1/0 only — a typo is rejected, not coerced.
# TRUST_PROXY=false

# Salt for the stored session/audit IP hash (DB §4.1, DB §13). Optional here:
# development falls back to a constant default. REQUIRED under
# NODE_ENV=production, where that default would be a public constant and an IP
# hash salted with one enumerates straight back to the address.
#   openssl rand -hex 32
# NAIGX_IP_HASH_SECRET=""

# --- Real provider (optional) -------------------------------------------
# Only needed to run `npm run analyze -- <file> --provider anthropic` or the
# opt-in live tests. The stub and replay adapters, the whole offline test
# suite, and CI all work with none of these set.
#
# NEVER COMMIT A REAL KEY. `.env` is gitignored; `.env.example` is not.
ANTHROPIC_API_KEY=""
# D-65 (2026-09-09): claude-sonnet-5. Adaptive thinking is on by default there
# and sampling parameters are rejected; the adapter handles both. Rates below
# are the published $2 / $10 per MTok, verified against the pricing page.
PROVIDER_MODEL="claude-sonnet-5"
# Thinking depth: low | medium | high | xhigh | max. Omitted = high, whose
# latency the 2026-09-08 pilot recorded. medium is comparable to Sonnet 4.6.
PROVIDER_EFFORT="medium"
# FR-094 executor deadline in ms. Omitted = 180000, the default since Sprint 4.
# ⚠️ Observed 2026-09-09: on claude-sonnet-5 at medium effort the
# job_description path takes ~195 s before Stage 9 finishes, so a deadline of
# 180 s marks completed work `timed_out`. NFR-002's p95 (120 s) is below either
# value; this is an execution guard, not the requirement.
# NAIGX_ANALYSIS_TIMEOUT_MS="420000"

# USD per million tokens, as decimal strings. Required for any real call:
# cost must be recorded per call (SA §3.5, NFR-083) and no rate is assumed.
# Take the current published rates for the model above.
PROVIDER_INPUT_USD_PER_MTOK="2.00"
PROVIDER_OUTPUT_USD_PER_MTOK="10.00"

# --- Managed key service (D-52, DB §13.1 row 3) -----------------------------
# Optional in development: with these unset, the OFFLINE test double provides
# the key, so a clean checkout encrypts and decrypts with no AWS account and no
# spend. That double refuses to construct under NODE_ENV=production.
#
# ⚠️ REQUIRED in production. There is no local-key fallback by design.
# NAIGX_KMS_KEY_ID="alias/naigx"
# NAIGX_KMS_REGION="ap-southeast-1"

# Set to 1, with the two above, to run the live KMS integration test — the only
# thing that verifies the real service. It is skipped otherwise, and a skip
# means NOT CHECKED.
# NAIGX_KMS_LIVE_TEST=1
