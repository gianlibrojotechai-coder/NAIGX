{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naigx/schemas/n8n_workflow.schema.json",
  "title": "n8n Workflow",
  "description": "D-71: an n8n import file rendered deterministically from the portfolio project's implementation plan — one node per step, wired in order, with a sticky note per node carrying purpose, setup and credential, and a header note stating that it is a scaffold. Repository-authored per docs/12 D-1, published to ARTIFACT_SCHEMA. The root keys are n8n's own (name, nodes, connections, settings); `naigx` carries the standing and the mapping outcome so the stored document says what it is (DP-1). additionalProperties is open at the root to stay tolerant of n8n's own optional keys.",
  "type": "object",
  "required": ["name", "nodes", "connections", "settings", "naigx"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "description": "At least the README note and one step node.",
      "items": { "$ref": "#/$defs/node" }
    },
    "connections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["main"],
        "properties": {
          "main": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["node", "type", "index"],
                "properties": {
                  "node": { "type": "string", "minLength": 1 },
                  "type": { "const": "main" },
                  "index": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "settings": { "type": "object" },
    "naigx": {
      "type": "object",
      "required": ["standing", "platform", "steps_mapped", "steps_unmapped"],
      "properties": {
        "standing": { "const": "scaffold" },
        "platform": { "type": "string", "minLength": 1 },
        "steps_mapped": { "type": "integer", "minimum": 0 },
        "steps_unmapped": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["parameters", "name", "type", "typeVersion", "position"],
      "properties": {
        "parameters": { "type": "object" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "pattern": "^n8n-nodes-base\\." },
        "typeVersion": { "type": "number", "minimum": 1 },
        "position": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
