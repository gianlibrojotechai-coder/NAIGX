{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "oxlint src tests",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "prisma:generate": "prisma generate && prisma generate --config prisma.trace.config.ts",
    "prisma:migrate": "prisma migrate dev && prisma migrate dev --config prisma.trace.config.ts",
    "prisma:deploy": "prisma migrate deploy && prisma migrate deploy --config prisma.trace.config.ts",
    "fragments:check": "tsx scripts/fragments.mts check",
    "fragments:write": "tsx scripts/fragments.mts write",
    "fragments:publish": "tsx scripts/fragments.mts publish",
    "regression:status": "tsx scripts/regression.mts status",
    "regression:recordings:check": "tsx scripts/regression.mts recordings:check",
    "regression:recordings:write": "tsx scripts/regression.mts recordings:write",
    "regression:capture": "tsx scripts/regression.mts capture",
    "regression:capture:dry": "tsx scripts/regression.mts capture --dry-run",
    "regression:run": "tsx scripts/regression.mts run",
    "analyze": "tsx scripts/analyze.mts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@fastify/cors": "^11.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
